{
  "name": "claude-matrix-server",
  "version": "0.2.0",
  "type": "module",
  "main": "build/index.mjs",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=build/index.mjs --banner:js='// claude-matrix MCP server — bundled with esbuild'",
    "build:types": "tsc --emitDeclarationOnly",
    "dev": "tsx watch src/index.ts",
    "start": "node build/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.16.0",
    "chokidar": "^4.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.27.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
